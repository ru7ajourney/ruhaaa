# ===================================
# Ruha Backend - Environment Variables
# ===================================
# انسخ هذا الملف وسميه .env وعدّل القيم

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ruha

# JWT Secret - غيّره لشيء صعب تخمينه
JWT_SECRET=ruha_super_secret_key_change_this

# JWT expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Admin credentials - هذه بيانات الآدمن الوحيد
ADMIN_EMAIL=admin@ruha.com
ADMIN_PASSWORD=ruha_admin_2024

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
