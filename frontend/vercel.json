{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm install && node ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
